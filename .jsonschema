{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hacktoberfest-swag.com/schemas/opportunity.json",
  "title": "Hacktoberfest swag opportunity",
  "description": "A verified, community-submitted Hacktoberfest swag opportunity.",
  "type": "object",
  "required": ["Name", "Website", "Swag", "Description", "Details"],
  "properties": {
    "Name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "Website": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "Swag": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["glasses", "laptop", "mask", "mug", "other", "plant", "shirt", "socks", "stickers", "swag"]
      }
    },
    "Description": {
      "type": "string",
      "minLength": 25,
      "maxLength": 1000
    },
    "Details": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    }
  },
  "additionalProperties": false
}
